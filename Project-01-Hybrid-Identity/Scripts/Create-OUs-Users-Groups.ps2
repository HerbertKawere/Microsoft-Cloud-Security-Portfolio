> Import-Module ActiveDirectory
> Get-Module ActiveDirectory -ListAvailable


# Domain DN
$DomainDN = "DC=snl,DC=herbertlab,DC=local"

# Create top-level OU
New-ADOrganizationalUnit `
    -Name "SNL" `
    -Path $DomainDN `
    -ProtectedFromAccidentalDeletion $true

# Child OUs
$ChildOUs = @(
    "Users",
    "Groups",
    "Servers",
    "Workstations",
    "Service Accounts"
)

foreach ($OU in $ChildOUs)
{
    New-ADOrganizationalUnit `
        -Name $OU `
        -Path "OU=SNL,$DomainDN" `
        -ProtectedFromAccidentalDeletion $true
}




$GroupsOU = "OU=Groups,OU=SNL,DC=snl,DC=herbertlab,DC=local"

$Groups = @(
    "IT Admins",
    "HR Users",
    "Finance Users",
)

foreach ($Group in $Groups)
{
    New-ADGroup `
        -Name $Group `
        -SamAccountName ($Group -replace " ","") `
        -GroupScope Global `
        -GroupCategory Security `
        -Path $GroupsOU
}





$password = ConvertTo-SecureString "123Qwe,./!@" -AsPlainText -Force

New-ADUser `
    -Name "John Smith" `
    -GivenName "John" `
    -Surname "Smith" `
    -SamAccountName "jsmith" `
    -UserPrincipalName "jsmith@snlug.com" `
    -Path "OU=Users,OU=SNL,DC=snl,DC=herbertlab,DC=local" `
    -AccountPassword $password `
    -Enabled $true `
    -ChangePasswordAtLogon $true